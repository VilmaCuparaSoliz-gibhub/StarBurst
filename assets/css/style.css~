/* RECURSOS */

/* Reset y Base */
* { margin: 0; padding: 0; box-sizing: border-box; }

.re-principal {
    background-color: #F0F0F0; /* Fondo gris claro tipo Windows */
    min-height: 100vh;
    font-family: 'Segoe UI', Tahoma, sans-serif;
}

/* Colores de Cabecera (Ajustados a tu estilo previo pero más limpios) */
.re-header1 { background-color: #2C2C2C; padding: 5px 15px; color: white; }
.re-header2 { background-color: #000; padding: 8px 15px; border-top: 4px solid #FFF; color: white; }
.re-header3 { background-color: #244E72; padding: 10px; text-align: center; color: white; }

/* Distribución Principal */
.re-contenido {
    display: flex;
    padding: 20px;
    gap: 50px; /* Separación entre columnas */
}

/* Menú Lateral */
.re-menu {
    display: flex;
    flex-direction: column;
    gap: 30px; /* Separación entre bloques de botones */
}

.re-grupo-gestion, .re-grupo-herramientas {
    display: flex;
    flex-direction: column;
    gap: 4px; /* Botones casi pegados como en la imagen */
}

/* Estilo de Botón VFP (Plateado Azulado) */
.vfp-button {
    background: linear-gradient(to bottom, #e1e9f5 0%, #bdcce3 100%);
    border: 1px solid #7a8a99;
    color: #000;
    padding: 6px 20px;
    font-size: 14px;
    text-align: left;
    cursor: pointer;
    box-shadow: inset 1px 1px 0px #fff;
}

.vfp-button:hover {
    background: linear-gradient(to bottom, #d1dbe9 0%, #a8bad6 100%);
}

/* Panel Derecho */
.re-panel {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* Esto empuja el botón Salir abajo */
}

.re-input-gestion {
    text-align: right;
    margin-bottom: 10px;
}

.vfp-input-small {
    width: 150px;
    text-align: center;
    border: 1px solid #7a8a99;
    padding: 3px;
    background-color: #f7faff;
}

.vfp-textarea {
    width: 100%;
    border: 1px solid #7a8a99;
    background-color: #f7faff;
    margin-bottom: 20px;
}

/* Botón Salir en la esquina */
.re-footer {
    display: flex;
    justify-content: flex-end;
}

.vfp-button-exit {
    background: linear-gradient(to bottom, #e1e9f5 0%, #bdcce3 100%);
    border: 1px solid #7a8a99;
    padding: 5px 25px;
    box-shadow: inset 1px 1px 0px #fff;
}
